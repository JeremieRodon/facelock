<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>Facelock</vendor>
  <vendor_url>https://github.com/tyvsmith/facelock</vendor_url>

  <!-- Grants a non-root caller the right to receive raw camera frame bytes
       from PreviewDetectFrame (the enroll/preview UI). auth_self_keep:
       requires the caller's own password interactively, only from an active
       local session, and the grant is short-lived (polkit retains it for
       ~5 minutes). Remote / sessionless subjects are denied outright, and
       the daemon fails closed (metadata-only) on any polkit error. -->
  <action id="org.facelock.preview-frames">
    <description>View live camera frames in the facelock preview</description>
    <message>Authentication is required to view live frames from the face recognition camera</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_self_keep</allow_active>
    </defaults>
  </action>
</policyconfig>
